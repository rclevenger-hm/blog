---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
const engineeringTags = new Set(['SRE','Engineering','Reliability','Observability','Kubernetes','Infrastructure','Automation']);
const posts = (await getCollection('blog', ({ data }) => !data.draft && data.tags.some(tag => engineeringTags.has(tag))))
  .sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<BaseLayout title="Engineering — Roger Clevenger" description="SRE, infrastructure, reliability and automation writing by Roger Clevenger.">
  <main class="shell content-page">
    <div class="eyebrow">Systems</div>
    <h1 class="page-title">Engineering</h1>
    <p class="page-lede">Reliability engineering, infrastructure, observability, automation, and lessons learned from operating systems that have to keep working when nobody is watching.</p>
    <div class="list-stack">
      {posts.map(post => (
        <article class="list-card">
          <div>
            <div class="kicker">{post.data.tags.join(' · ')}</div>
            <h2><a href={`${base}posts/${post.id}/`}>{post.data.title}</a></h2>
            <p>{post.data.description}</p>
            <div class="meta">{post.data.date.toLocaleDateString('en-US', {month:'long', day:'numeric', year:'numeric'})}{post.data.readTime ? ` · ${post.data.readTime}` : ''}</div>
          </div>
          <a aria-label={`Read ${post.data.title}`} href={`${base}posts/${post.id}/`}>→</a>
        </article>
      ))}
    </div>
  </main>
</BaseLayout>
