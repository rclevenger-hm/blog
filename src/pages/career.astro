---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
const posts = (await getCollection('blog', ({ data }) => !data.draft && data.tags.includes('Career')))
  .sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<BaseLayout title="Career — Roger Clevenger" description="Writing about engineering careers, remote work, technical leadership and sustainable work.">
  <main class="shell content-page">
    <div class="eyebrow">Work</div>
    <h1 class="page-title">Career</h1>
    <p class="page-lede">The less tidy side of engineering: seniority, remote work, layoffs, interviews, sustainable pace, and figuring out what kind of technical work is actually worth doing.</p>
    {posts.length ? (
      <div class="list-stack">
        {posts.map(post => (
          <article class="list-card">
            <div>
              <div class="kicker">{post.data.tags.join(' · ')}</div>
              <h2><a href={`${base}posts/${post.id}/`}>{post.data.title}</a></h2>
              <p>{post.data.description}</p>
              <div class="meta">{post.data.date.toLocaleDateString('en-US', {month:'long', day:'numeric', year:'numeric'})}{post.data.readTime ? ` · ${post.data.readTime}` : ''}</div>
            </div>
            <a aria-label={`Read ${post.data.title}`} href={`${base}posts/${post.id}/`}>→</a>
          </article>
        ))}
      </div>
    ) : (
      <p class="page-lede">Career essays will appear here as they are published.</p>
    )}
  </main>
</BaseLayout>
