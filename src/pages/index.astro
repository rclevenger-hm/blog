---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
const allPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()
    || a.data.title.localeCompare(b.data.title));

const imageById = {
  'the-tech-job-search-changed': `${base}article-job-search.svg`,
  'google-antigravity-arcade-what-i-learned': `${base}article-antigravity.svg`,
  'leetcode-for-sre-and-devops-engineers': `${base}article-leetcode.svg`,
  'the-joy-of-sadservers': `${base}article-sadservers.svg`,
  'why-infrastructure-should-be-boring': `${base}article-boring.svg`,
  'why-i-built-an-on-call-cockpit': `${base}article-cockpit.svg`,
  'building-software-for-yourself-again': `${base}article-building.svg`
};

const posts = allPosts;
const formatDate = (date) => date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
const heroTags = ['SRE', 'Infrastructure', 'Automation', 'Cloud', 'AI', 'Career', 'Projects', 'Life'];
---
<BaseLayout
  title="Roger Clevenger — SRE, Infrastructure & Writing"
  description="Thoughts, lessons, and experiences from the front lines of reliability engineering, infrastructure, automation, AI, and technical work."
>
  <main class="publication-home">
    <section class="publication-hero">
      <div class="publication-hero-overlay"></div>
      <div class="publication-hero-inner">
        <div class="publication-portrait-wrap">
          <img class="publication-portrait" src="/blog/profile-roger-v2.webp" alt="Roger Clevenger" />
        </div>
        <div class="publication-intro">
          <div class="publication-kicker">Writing</div>
          <h1>Thoughts, lessons, and experiences from the front lines of technology.</h1>
          <p>I’m Roger Clevenger, a Principal Site Reliability Engineer focused on building reliable, scalable systems and practical automation. This is where I share technical deep dives, career insights, and ideas at the intersection of infrastructure, AI, and real-world engineering.</p>
          <div class="publication-tag-row">{heroTags.map(tag => <span>{tag}</span>)}</div>
        </div>
      </div>
    </section>

    <section class="publication-feed">
      <div class="publication-tabs" aria-label="Writing filters">
        <a class="active" href={base}>Latest</a>
        <span>Most Popular</span>
        <a href={`${base}writing/`}>Categories ↓</a>
      </div>

      <div class="publication-card-grid">
        {posts.map(post => (
          <article class="publication-card">
            <a class="publication-card-image-link" href={`${base}posts/${post.id}/`}>
              <img class="publication-card-image" src={imageById[post.id] ?? `${base}article-building.svg`} alt="" loading="lazy" />
            </a>
            <div class="publication-card-meta">{formatDate(post.data.date)}{post.data.readTime ? ` · ${post.data.readTime}` : ''}</div>
            <div class="publication-card-tags">{post.data.tags.slice(0, 4).map(tag => <span>{tag}</span>)}</div>
            <h2><a href={`${base}posts/${post.id}/`}>{post.data.title}</a></h2>
            <p>{post.data.description}</p>
            <a class="publication-read-more" href={`${base}posts/${post.id}/`}>Read more →</a>
          </article>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
