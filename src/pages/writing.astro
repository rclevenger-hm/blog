---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<BaseLayout title="Writing — Roger Clevenger" description="Engineering, SRE, systems, automation and career writing by Roger Clevenger.">
  <main class="shell content-page">
    <div class="eyebrow">Archive</div>
    <h1 class="page-title">Writing</h1>
    <p class="page-lede">Notes and essays about infrastructure, SRE, engineering systems, automation, technical work, and the parts of a career that do not fit cleanly into a runbook.</p>
    <div class="list-stack">
      {posts.map(post => (
        <article class="list-card">
          <div>
            <div class="kicker">{post.data.tags.join(' · ')}</div>
            <h2><a href={`${base}posts/${post.id}/`}>{post.data.title}</a></h2>
            <p>{post.data.description}</p>
            <div class="meta">{post.data.date.toLocaleDateString('en-US', {month:'long', day:'numeric', year:'numeric'})}{post.data.readTime ? ` · ${post.data.readTime}` : ''}</div>
          </div>
          <a aria-label={`Read ${post.data.title}`} href={`${base}posts/${post.id}/`}>→</a>
        </article>
      ))}
    </div>
  </main>
</BaseLayout>
