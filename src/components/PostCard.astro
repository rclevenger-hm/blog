---
const { post } = Astro.props;
const base = import.meta.env.BASE_URL;
const date = post.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
---
<a class="post-card" href={`${base}posts/${post.id}/`}>
  <div class="kicker">{post.data.tags.slice(0, 2).join(' · ')}</div>
  <h3>{post.data.title}</h3>
  <p>{post.data.description}</p>
  <div class="meta">{date}{post.data.readTime ? ` · ${post.data.readTime}` : ''}</div>
</a>
